# RPC Endpoints
VITE_RPC_URL_PRODUCTION=https://qrlwallet.com/api/qrl-rpc
VITE_RPC_URL_DEVELOPMENT=http://localhost:8545

# API Server Endpoints
VITE_SERVER_URL_PRODUCTION=https://qrlwallet.com/api
VITE_SERVER_URL_DEVELOPMENT=http://localhost:3000/api

# Block Explorer
VITE_EXPLORER_URL_PRODUCTION=https://zondscan.com
VITE_EXPLORER_URL_DEVELOPMENT=https://zondscan.com

# QRNS deployments (both values are required for each enabled network)
# Chain IDs must use canonical lowercase 0x hex. Registries must use canonical
# nonzero QIP-55 addresses. Keep these empty until that network has a reviewed
# QNS deployment.
VITE_QRNS_CHAIN_ID_TEST_NET=""
VITE_QRNS_REGISTRY_TEST_NET=""
VITE_QRNS_CHAIN_ID_MAIN_NET=""
VITE_QRNS_REGISTRY_MAIN_NET=""

# Token Factory Contract Address (deploy using qrl-erc20-factory)
VITE_CUSTOMERC20FACTORY_ADDRESS=""

# Deployer Account (account that deployed the factory)
VITE_DEPLOYER=""

# Dedicated v3 profile for browser and qualified desktop builds.
# Keep empty for the default build.
# All VITE_ values are public browser configuration. Never include credentials.
# V3 requires all five values, including the full RPC URL with /testnet.
VITE_WALLET_PROFILE=""
VITE_V3_RPC_URL=""
VITE_V3_SERVER_URL=""
VITE_V3_EXPLORER_URL=""
VITE_V3_CHAIN_ID=""
VITE_V3_GENESIS_HASH=""

# Optional reviewed v3 deployments. Empty values keep each feature disabled.
# Use the canonical checksummed 64-byte QRL addresses on the pinned v3 network.
# Historical testnet factory and QNS settings are never reused by this profile.
VITE_V3_FACTORY_ADDRESS=""
VITE_V3_QNS_REGISTRY=""

# Dormant QRL 2.0 mainnet (v3 profile only). Leave both pins empty until the
# mainnet chain id and genesis hash are published: the build then carries no
# mainnet at all. Setting one pin without the other, or a pin equal to the
# testnet one, fails the build. Fiat values show only on this pinned network.
VITE_MAINNET_CHAIN_ID=""
VITE_MAINNET_GENESIS_HASH=""
# Optional. RPC defaults to https://qrlwallet.com/api/qrl-rpc/mainnet and the
# server to VITE_V3_SERVER_URL (a web build listing both networks needs the
# same server for both). An empty explorer means no explorer links, no
# explorer discovery and no price. Empty QNS and factory keep those features
# off on mainnet.
VITE_MAINNET_RPC_URL=""
VITE_MAINNET_SERVER_URL=""
VITE_MAINNET_EXPLORER_URL=""
VITE_MAINNET_QNS_REGISTRY=""
VITE_MAINNET_FACTORY_ADDRESS=""

# testnet (default) or mainnet. mainnet is valid only with both pins set.
# VITE_DEFAULT_NETWORK picks the network a web build starts on. Native builds
# (desktop renderer, app-embedded document) list only VITE_V3_NATIVE_NETWORK.
VITE_DEFAULT_NETWORK=""
VITE_V3_NATIVE_NETWORK=""
