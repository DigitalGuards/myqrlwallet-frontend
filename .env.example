# RPC Endpoints
VITE_RPC_URL_PRODUCTION=https://qrlwallet.com/api/qrl-rpc
VITE_RPC_URL_DEVELOPMENT=http://localhost:8545

# API Server Endpoints
VITE_SERVER_URL_PRODUCTION=https://qrlwallet.com/api
VITE_SERVER_URL_DEVELOPMENT=http://localhost:3000/api

# Block Explorer
VITE_EXPLORER_URL_PRODUCTION=https://zondscan.com
VITE_EXPLORER_URL_DEVELOPMENT=https://zondscan.com

# QRNS deployments (both values are required for each enabled network)
# Chain IDs must use canonical lowercase 0x hex. Registries must use canonical
# nonzero QIP-55 addresses. Keep these empty until that network has a reviewed
# QNS deployment.
VITE_QRNS_CHAIN_ID_TEST_NET=""
VITE_QRNS_REGISTRY_TEST_NET=""
VITE_QRNS_CHAIN_ID_MAIN_NET=""
VITE_QRNS_REGISTRY_MAIN_NET=""

# Token Factory Contract Address (deploy using qrl-erc20-factory)
VITE_CUSTOMERC20FACTORY_ADDRESS=""

# Deployer Account (account that deployed the factory)
VITE_DEPLOYER=""

# Dedicated v3 profile for browser and qualified desktop builds.
# Keep empty for the default build.
# All VITE_ values are public browser configuration. Never include credentials.
# V3 requires all five values, including the full RPC URL with /testnet.
VITE_WALLET_PROFILE=""
VITE_V3_RPC_URL=""
VITE_V3_SERVER_URL=""
VITE_V3_EXPLORER_URL=""
VITE_V3_CHAIN_ID=""
VITE_V3_GENESIS_HASH=""
